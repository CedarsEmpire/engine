<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ENGINE FIVE — Real Work Platform</title>
<style>
  *{box-sizing:border-box}
  body{margin:0;background:#0a0a0f;color:#fff;font-family:Inter,Arial,sans-serif;padding:18px}
  .top{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px}
  .logo{font-size:28px;font-weight:900;letter-spacing:2px}
  .logo span{color:#22c55e;font-size:13px;letter-spacing:1px;border:1px solid #22c55e;padding:5px 10px;border-radius:20px}
  .pill{background:#15151d;border:1px solid #2a2a35;padding:10px 14px;border-radius:12px;font-size:13px}
  .pill b{color:#22c55e}
  .grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:16px}
  @media(max-width:700px){.grid{grid-template-columns:1fr}}
  .card{background:#13131b;border:1px solid #262633;border-radius:16px;padding:18px}
  .card h2{margin:0 0 6px;font-size:17px}
  .card p{margin:0;color:#a1a1b3;font-size:13px;line-height:1.5}
  .big{font-size:32px;font-weight:900;margin:8px 0 4px}
  .bar{height:10px;background:#262633;border-radius:20px;overflow:hidden;margin-top:10px}
  .fill{height:100%;background:linear-gradient(90deg,#22c55e,#a3e635)}
  .fill2{height:100%;background:linear-gradient(90deg,#3b82f6,#22d3ee)}
  .row{display:flex;justify-content:space-between;font-size:12px;color:#a1a1b3;margin-top:6px}
  .engines{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin-top:16px}
  @media(max-width:900px){.engines{grid-template-columns:repeat(2,1fr)}}
  .eng{background:#13131b;border:1px solid #262633;border-radius:14px;padding:14px;text-align:center}
  .eng b{display:block;font-size:14px;margin:6px 0 4px}
  .eng small{color:#a1a1b3;font-size:11px;line-height:1.4;display:block}
  .dot{width:10px;height:10px;border-radius:50%;background:#22c55e;display:inline-block}
  h3{margin:22px 0 10px}
  .conts{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
  @media(max-width:700px){.conts{grid-template-columns:1fr 1fr}}
  .cont{background:#13131b;border:1px solid #262633;border-radius:14px;padding:16px;display:flex;justify-content:space-between;align-items:center}
  .cont b{font-size:15px}.cont small{color:#a1a1b3;display:block;font-size:12px}
  button{border:none;padding:8px 16px;border-radius:20px;font-weight:800;cursor:pointer}
  .on{background:#22c55e;color:#fff}.off{background:#3a3a45;color:#fff}
  table{width:100%;border-collapse:collapse;background:#13131b;border-radius:14px;overflow:hidden}
  th,td{padding:12px;text-align:left;font-size:13px;border-bottom:1px solid #262633}
  th{color:#a1a1b3}
  .tag{padding:4px 8px;border-radius:20px;font-size:11px;font-weight:800}
  .escrow{background:#fef08a;color:#000}.paid{background:#22c55e}.review{background:#3b82f6}
  .tabs{display:flex;gap:8px;margin-top:18px;flex-wrap:wrap}
  .tabs button{background:#1c1c26;color:#fff;border:1px solid #333}
  .tabs button.active{background:#fff;color:#000}
  input,select{width:100%;padding:12px;border-radius:10px;border:1px solid #333;background:#0f0f15;color:#fff;margin-top:8px}
  .btn-green{background:#22c55e;color:#000;width:100%;padding:13px;margin-top:10px;font-size:15px}
  .note{background:#1a2a1a;border:1px solid #22c55e;padding:12px;border-radius:12px;font-size:12px;margin-top:14px;line-height:1.6}
</style>
</head>
<body>

<div class="top">
  <div class="logo">ENGINE FIVE <span>● LIVE • REAL WORK ONLY</span></div>
  <div class="pill">Escrow Funded: <b id="escrowBal">€0.00</b> • No escrow = No task goes live</div>
</div>

<div class="grid">
  <!-- AUTOMATED AI TARGET -->
  <div class="card">
    <h2>🤖 Automated AI Engine — Target</h2>
    <p>AI does pre-check, gold-task injection, duplicate detection. AI never approves alone — human approves.</p>
    <div class="big">€<span id="aiEarned">0</span> <span style="font-size:15px;color:#a1a1b3">/ €2500 target • 24h</span></div>
    <div class="bar"><div class="fill" id="aiBar" style="width:0%"></div></div>
    <div class="row"><span id="aiPct">0% of daily target</span><span>Resets 00:00 UTC</span></div>
    <p style="margin-top:10px">Source: Client orders only. Not from new workers.</p>
  </div>

  <!-- HUMAN TARGET -->
  <div class="card">
    <h2>👤 Human Worker — Daily Target</h2>
    <p>Real tasks, priced by client before you accept. Pay on QA approval.</p>
    <div class="big">€<span id="humanEarned">0</span> <span style="font-size:15px;color:#a1a1b3">/ €15 daily target</span></div>
    <div class="bar"><div class="fill2" id="humanBar" style="width:0%"></div></div>
    <div class="row"><span id="humanPct">0% of €15</span><span>Example: 5 tasks x €3 = €15</span></div>
    <button class="btn-green" onclick="showTab('tasks')">Browse Live Tasks →</button>
  </div>
</div>

<!-- ALL 5 ENGINES -->
<h3>⚙️ All Engines — How Money Flows</h3>
<div class="engines">
  <div class="eng"><span class="dot"></span><b>1. CLIENT ENGINE</b><small>Client posts task + funds escrow FIRST</small><br><small id="c1">0 active clients</small></div>
  <div class="eng"><span class="dot"></span><b>2. TASK ENGINE</b><small>Label • Rate AI • Transcribe • Field Photo</small><br><small id="c2">0 live tasks</small></div>
  <div class="eng"><span class="dot"></span><b>3. WORKER ENGINE</b><small>Free join • 70% test to unlock • Levels</small><br><small id="c3">0 workers qualified</small></div>
  <div class="eng"><span class="dot"></span><b>4. AI VERIFICATION</b><small>AI flags → Gold tasks → 2x check → Human approves</small><br><small id="c4">Accuracy: --%</small></div>
  <div class="eng"><span class="dot"></span><b>5. PAYOUT ENGINE</b><small>Pay on approval • M-Pesa / Payoneer • Weekly</small><br><small id="c5">€0 paid out</small></div>
</div>

<!-- CONTINENTS -->
<h3>🌍 Continents — Not Regions</h3>
<div class="conts" id="conts"></div>

<div class="tabs">
  <button class="active" onclick="showTab('tasks',this)">Live Tasks</button>
  <button onclick="showTab('verify',this)">AI Verification Flow</button>
  <button onclick="showTab('client',this)">Post a Task (Client)</button>
  <button onclick="showTab('worker',this)">Become a Worker</button>
</div>

<!-- TASKS -->
<div id="tab-tasks" class="card" style="margin-top:12px">
  <h2>Live Tasks — Only show if escrow funded</h2>
  <table>
    <tr><th>Task</th><th>Continent</th><th>Pay</th><th>Type</th><th>Status</th></tr>
    <tr><td colspan="5" style="text-align:center;color:#a1a1b3;padding:20px">No live tasks yet. First client must fund escrow to unlock tasks.<br><button class="btn-green" style="max-width:280px" onclick="showTab('client')">+ Post First Client Order</button></td></tr>
  </table>
  <div class="note">⚠️ RULE: If a task asks you to pay, deposit crypto, or invite people to earn — report it. Real platforms NEVER charge workers.</div>
</div>

<!-- VERIFY -->
<div id="tab-verify" class="card" style="margin-top:12px;display:none">
  <h2>AI Verification — 4 Steps, No Fake Approvals</h2>
  <p><b>1. AI Pre-Check:</b> Blurry, duplicate, too-fast, copy-paste → flagged</p>
  <p><b>2. Gold Tasks:</b> Every 10th task is a hidden test with known answer. Fail gold = accuracy drops.</p>
  <p><b>3. Double Work:</b> Same task to 2 workers. Disagree → goes to Expert.</p>
  <p><b>4. Human Final:</b> Human reviewer approves → Escrow releases → Worker paid.</p>
  <p style="color:#22c55e;margin-top:10px">AI suggests. Humans decide. That's what makes it legit.</p>
</div>

<!-- CLIENT -->
<div id="tab-client" class="card" style="margin-top:12px;display:none">
  <h2>Post a Task — Client</h2>
  <p>Money goes to escrow first. Workers only see task after you fund it.</p>
  <input id="ctitle" placeholder="e.g. Label 500 shop photos - Africa">
  <select id="ccont"><option>Africa</option><option>North America</option><option>South America</option><option>Europe</option><option>Asia</option><option>Oceania</option></select>
  <input id="cprice" type="number" placeholder="Price per task in € - e.g. 3">
  <input id="cvol" type="number" placeholder="Volume - e.g. 100">
  <button class="btn-green" onclick="createOrder()">Calculate & Fund Escrow →</button>
  <p id="cresult" style="margin-top:10px"></p>
</div>

<!-- WORKER -->
<div id="tab-worker" class="card" style="margin-top:12px;display:none">
  <h2>Become a Worker — Free, No Deposit</h2>
  <p>1. Create account • 2. Take 20-task qualification test (need 70%) • 3. Unlock paid tasks • 4. Get paid on approval</p>
  <input placeholder="Full Name">
  <input placeholder="Email / WhatsApp">
  <select><option>Africa</option><option>North America</option><option>South America</option><option>Europe</option><option>Asia</option><option>Oceania</option></select>
  <button class="btn-green" onclick="alert('Qualification test will open. You need 70% to unlock paid work.')">Start Free Qualification Test</button>
  <p style="font-size:12px;color:#a1a1b3;margin-top:8px">We never ask for crypto, deposit, or payment to unlock tasks.</p>
</div>

<script>
let conts = [
  {name:"Africa", code:"AF", workers:"Focus: Luganda, Swahili, English", on:true},
  {name:"North America", code:"NA", workers:"Focus: English, Spanish", on:true},
  {name:"South America", code:"SA", workers:"Focus: Spanish, Portuguese", on:false},
  {name:"Europe", code:"EU", workers:"Focus: English, French, German", on:true},
  {name:"Asia", code:"AS", workers:"Focus: Hindi, Tagalog, English", on:false},
  {name:"Oceania", code:"OC", workers:"Focus: English", on:false},
];
function renderConts(){
  document.getElementById('conts').innerHTML = conts.map((c,i)=>`
    <div class="cont"><div><b>${c.name}</b><small>${c.workers}</small><small style="margin-top:4px">Tasks: 0 • Escrow: €0</small></div>
    <button class="${c.on?'on':'off'}" onclick="toggleCont(${i})">${c.on?'ON':'OFF'}</button></div>`).join('');
}
function toggleCont(i){ conts[i].on=!conts[i].on; renderConts(); }
renderConts();

function showTab(name, btn){
  ['tasks','verify','client','worker'].forEach(t=>document.getElementById('tab-'+t).style.display = t===name?'block':'none');
  if(btn){ document.querySelectorAll('.tabs button').forEach(b=>b.classList.remove('active')); btn.classList.add('active'); }
}
function createOrder(){
  let price = parseFloat(document.getElementById('cprice').value||0);
  let vol = parseFloat(document.getElementById('cvol').value||0);
  let title = document.getElementById('ctitle').value||'Untitled';
  let cont = document.getElementById('ccont').value;
  if(!price||!vol){ document.getElementById('cresult').innerHTML='Enter price + volume'; return; }
  let workerPay = price*vol;
  let fee = workerPay*0.20;
  let total = workerPay+fee;
  document.getElementById('cresult').innerHTML = `<b>${title} — ${cont}</b><br>Workers get: €${workerPay} (€${price} x ${vol})<br>Platform fee 20%: €${fee.toFixed(2)}<br><b>Total to fund in escrow: €${total.toFixed(2)}</b><br><span style="color:#22c55e">This is how €2500 target is built — from real client orders, not from new workers.</span>`;
  document.getElementById('escrowBal').innerText = '€'+total.toFixed(2)+' (Demo calc)';
  // Update AI target bar for demo
  let pct = Math.min(100, (total/2500)*100);
  document.getElementById('aiEarned').innerText = total.toFixed(0);
  document.getElementById('aiBar').style.width = pct+'%';
  document.getElementById('aiPct').innerText = pct.toFixed(1)+'% of daily target';
}
</script>
</body>
</html>
